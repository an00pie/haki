# ==========================================
# HaKi - Environment Configuration
# ==========================================

# Application Name
APP_NAME=HaKi

# Database Connection (SQLite local ACID database by default)
DATABASE_URL=sqlite:///./data/haki.db
DATA_DIR=./data

# Local Ollama AI Settings (Strictly loopback-only; no external cloud model calls)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TEXT_MODEL=gemma:2b

# Operational & Forensic File Limits
MAX_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=100
MAX_VIDEO_DURATION_SECONDS=180
MAX_VIDEO_FRAMES=12

# Verification & Scoring Thresholds
VIDEO_VERIFICATION_THRESHOLD=40
STAGE2_THRESHOLD=40
MAX_TOOL_EXECUTIONS=10
NODE_RETRY_LIMIT=2
FETCH_TIMEOUT_S=10.0

# Public Storefront & Domain Checks (SSRF-protected)
# Set to true to enable outbound public store page retrieval, RDAP, and archive lookups
PUBLIC_CHECKS_ENABLED=true

# Optional Brave Search API Key (Used strictly on backend for public complaint discovery)
BRAVE_SEARCH_API_KEY=

# Optional Meta / Instagram Graph API Access Token (Used strictly on backend for official business account data)
# Never sent to browser/extension. Falls back gracefully to manual input / visible-page extraction if empty.
INSTAGRAM_API_TOKEN=
META_APP_ID=
META_APP_SECRET=

# CORS Allowed Origins (Comma-separated list of web frontend URLs)
# Chrome extension origins matching chrome-extension://[a-p]{32} are allowed automatically.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
